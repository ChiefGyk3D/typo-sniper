# Typo Sniper - Dockerfile with Doppler Support
# Licensed under the GNU AGPL v3. Commercial licensing: see COMMERCIAL.md
#
# This Dockerfile includes the optional Doppler CLI for secrets management.
# Use the standard Dockerfile if Doppler is not needed.

FROM python:3.13-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip wheel --no-cache-dir --wheel-dir /wheels -r requirements.txt


FROM python:3.13-slim

LABEL maintainer="chiefgyk3d"
LABEL org.opencontainers.image.title="Typo Sniper (Doppler)"
LABEL org.opencontainers.image.description="Typo Sniper with Doppler secrets management"
LABEL org.opencontainers.image.licenses="AGPL-3.0-or-later"
LABEL org.opencontainers.image.source="https://github.com/ChiefGyk3D/typo-sniper"

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gnupg \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install the Doppler CLI. A failure here must fail the build rather than
# producing an image whose entrypoint silently cannot find `doppler`.
RUN curl -Ls --tlsv1.2 --proto "=https" --retry 3 https://cli.doppler.com/install.sh | sh \
    && doppler --version

COPY --from=builder /wheels /wheels
COPY requirements.txt .
RUN pip install --no-cache-dir --no-index --find-links=/wheels -r requirements.txt \
    && rm -rf /wheels

COPY pyproject.toml README.md LICENSE ./
COPY src/ ./src/
RUN pip install --no-cache-dir --no-deps .

RUN useradd --create-home --uid 10001 sniper \
    && mkdir -p /app/data /app/results /home/sniper/.typo_sniper/cache \
    && chown -R sniper:sniper /app /home/sniper

USER sniper

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV CACHE_DIR=/home/sniper/.typo_sniper/cache

VOLUME ["/app/data", "/app/results", "/home/sniper/.typo_sniper/cache"]

# Uses Doppler when DOPPLER_TOKEN is set, otherwise runs directly
ENTRYPOINT ["sh", "-c", "if [ -n \"$DOPPLER_TOKEN\" ]; then echo 'Using Doppler for secrets...'; exec doppler run -- typo-sniper \"$@\"; else exec typo-sniper \"$@\"; fi", "--"]
CMD ["--help"]
